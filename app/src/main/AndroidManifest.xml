<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"
        tools:ignore="ForegroundServicesPolicy" />
    <!--
      Required specifically for StatusForegroundService's specialUse FGS
      type below, and is itself a Play Store "restricted permission" if
      you ever publish - see the justification note in README.md.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!--
      Required on API 33+ for SetupNotifier's "open the app to grant
      Shizuku permission" notification to actually show - it's a
      runtime-requestable permission, requested once in MainActivity.kt.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Without this, ButtonMapperService's resolveLaunchIntent() silently
      fails to find any of the mapped apps at all, even though their own
      manifests declare perfectly correct LAUNCHER/HOME/LEANBACK_LAUNCHER
      categories. As of API 30+, package-visibility filtering means an
      app can't see another app's components at all
      (queryIntentActivities, getLaunchIntentForPackage, etc. all
      silently return nothing) unless it explicitly declares visibility
      to that package via queries. This isn't optional past targetSdk 30.
    -->
    <queries>
        <package android:name="com.odiousapps.mx3launcher" />
        <package android:name="app.smarttube.fdroid" />
        <package android:name="com.phlox.tvwebbrowser" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/banner"
        android:label="@string/app_name"
        android:theme="@style/Theme.ButtonMapper"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ButtonMapper">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Not launcher-visible, not exported - only ever started
          internally by ButtonMapperService.kt itself, never by another
          app. excludeFromRecents so it doesn't show up as its own
          separate "app" in the TV's recent-apps switcher, since it's a
          transient dialog, not something to switch back to.
        -->
        <activity
            android:name=".AppNotInstalledActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.ButtonMapper.Transparent" />

        <service
            android:name=".ButtonMapperService"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false"
            tools:ignore="AccessibilityPolicy">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
          Optional - only relevant if StatusForegroundService is
          actually started somewhere (it isn't wired up automatically).
          android:foregroundServiceType is MANDATORY on Android 14+
          (targetSdk 34+) - omitting it causes a
          MissingForegroundServiceTypeException at startForeground()
          time, not a silent failure. "specialUse" is the closest fit
          since none of the other FGS types (location, camera,
          mediaPlayback, etc.) describe input remapping.
        -->
        <service
            android:name=".StatusForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Hardware button remapping via accessibility service" />
        </service>

        <!--
          Pure no-op provider, see FileLogInitProvider.kt's own comment.
          Its only job is that the platform creates it (and so calls its
          onCreate()) before any other component in this process, so
          AppLog has a real log file to write to from the very first line
          this process ever logs, boot included.
        -->
        <provider
            android:name=".FileLogInitProvider"
            android:authorities="${applicationId}.loginit"
            android:exported="false"
            android:initOrder="100" />

        <!-- Required for Shizuku to talk to this app -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

    </application>

</manifest>

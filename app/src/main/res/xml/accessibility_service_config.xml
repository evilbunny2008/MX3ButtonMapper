<?xml version="1.0" encoding="utf-8"?>
<!--
  Key line: android:canRequestFilterKeyEvents="true"
  This is what allows onKeyEvent() to receive raw key/scancode data system-wide.
  Without it, the service will never see key events at all.

  Note: no android:packageNames attribute is set here on purpose - omitting
  it means "filter key events regardless of foreground app". Setting it to
  an empty string (as an earlier version of this file did) is NOT the same
  as omitting it - it restricts filtering to zero packages, silently
  disabling everything.

  Only typeWindowStateChanged is requested (ButtonMapperService only uses
  it to track the foreground app's package name), and window content
  can't be retrieved; kept as narrow as possible for Google Play's
  AccessibilityService API policy.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="0"
    />
